<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:data="clr-namespace:Joufflu.FileExplorer.Data"
    xmlns:fonts="clr-namespace:Joufflu.Assets.Fonts;assembly=Joufflu"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:local="clr-namespace:Joufflu.FileExplorer.Controls"
    xmlns:toolkit="clr-namespace:Joufflu.Toolkit;assembly=Joufflu">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Joufflu;component/Styles/Natives/Actions/Button.named.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Joufflu;component/Styles/Controls/DataDisplay/FontIcon.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="{x:Type local:ExplorerControlBar}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ExplorerControlBar}">
                    <Grid
                        toolkit:Sizing.Size="sm"
                        toolkit:Spacing.Gap="4"
                        DataContext="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!--  Opening the parent of the opened directory, nothing to go up to at the root.  -->
                        <Button
                            toolkit:Sizing.IsSquare="True"
                            Command="{Binding Source.OpenCommand}"
                            CommandParameter="{Binding Source.Current.Parent}"
                            ToolTip="Parent folder">
                            <Button.Style>
                                <Style BasedOn="{StaticResource GhostButton}" TargetType="{x:Type Button}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Source.Current.Parent}" Value="{x:Null}">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.ArrowUp}" />
                        </Button>

                        <!--  Scrolls rather than wraps, so that the bar keeps the height of a single row.  -->
                        <ScrollViewer
                            x:Name="PART_Breadcrumb"
                            Grid.Column="1"
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Source.Current.DirectoryTree}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type data:IExplorerDirectory}">
                                        <StackPanel Orientation="Horizontal">
                                            <fonts:FontIcon Foreground="{DynamicResource {x:Static joufflu:Brushes.Foreground100Brush}}" Text="{x:Static fonts:LucideFontIcons.ChevronRight}">
                                                <fonts:FontIcon.Style>
                                                    <Style BasedOn="{StaticResource {x:Type fonts:FontIcon}}" TargetType="{x:Type fonts:FontIcon}">
                                                        <Style.Triggers>
                                                            <!--  No separator before the first directory of the path.  -->
                                                            <DataTrigger Binding="{Binding Parent}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </fonts:FontIcon.Style>
                                            </fonts:FontIcon>
                                            <Button
                                                Command="{Binding Source.OpenCommand, RelativeSource={RelativeSource AncestorType={x:Type local:ExplorerControlBar}}}"
                                                CommandParameter="{Binding}"
                                                Content="{Binding Name}"
                                                Style="{StaticResource GhostButton}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
