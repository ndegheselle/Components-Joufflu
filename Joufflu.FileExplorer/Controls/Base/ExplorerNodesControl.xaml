<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:Joufflu.FileExplorer.Controls.Base"
    xmlns:converters="clr-namespace:Joufflu.FileExplorer.Converters"
    xmlns:toolkit="clr-namespace:Joufflu.Toolkit;assembly=Joufflu">

    <!--  Everything the controls displaying explorer nodes have in common, keyed on their base class.  -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Joufflu.FileExplorer;component/Controls/Base/ExplorerNode.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
        Name of the node being renamed, displayed in place of its visual. Validating or giving up runs the rename of
        the control, which ends the edition, so the node goes back to its visual on its own.
    -->
    <DataTemplate x:Key="ExplorerRenameTemplate">
        <TextBox
            MinWidth="80"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            base:ExplorerRename.Command="{Binding RenameCommand, RelativeSource={RelativeSource AncestorType={x:Type base:ExplorerNodesControl}}}"
            toolkit:Sizing.Size="xs"
            Text="{Binding Name, Mode=OneWay}" />
        <!--  OneWay : the name is only written back once the rename is validated, and by the source.  -->
    </DataTemplate>

    <!--  Visual of a node, replaced by its editable name while it is the one being renamed.  -->
    <DataTemplate x:Key="ExplorerNodeTemplate">
        <!--
            No ContentTemplate : the implicit template of the node type is resolved, the trigger replacing it with the
            editable name while the node is the one being renamed.
        -->
        <ContentPresenter x:Name="Presenter" Content="{Binding}" />
        <DataTemplate.Triggers>
            <DataTrigger Value="True">
                <DataTrigger.Binding>
                    <MultiBinding Converter="{x:Static converters:IsRenamedConverter.Default}">
                        <Binding />
                        <Binding Path="RenamedNode" RelativeSource="{RelativeSource AncestorType={x:Type base:ExplorerNodesControl}}" />
                    </MultiBinding>
                </DataTrigger.Binding>
                <Setter TargetName="Presenter" Property="ContentTemplate" Value="{StaticResource ExplorerRenameTemplate}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
</ResourceDictionary>
