<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fonts="clr-namespace:Joufflu.Assets.Fonts;assembly=Joufflu"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:local="clr-namespace:Joufflu.Inputs.Controls"
    xmlns:toolkit="clr-namespace:Joufflu.Toolkit;assembly=Joufflu">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Joufflu;component/Styles/Natives/Actions/Button.named.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="{x:Type local:TextEditable}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:TextEditable}">
                    <Grid DataContext="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                        <Grid x:Name="DisplayContainer">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="auto" />
                            </Grid.ColumnDefinitions>

                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <TextBlock
                                VerticalAlignment="Center"
                                Cursor="Hand"
                                Text="{Binding Text}"
                                ToolTip="Double click to edit">
                                <TextBlock.InputBindings>
                                    <MouseBinding Command="{Binding EditCommand}" Gesture="LeftDoubleClick" />
                                </TextBlock.InputBindings>
                                <TextBlock.TextDecorations>
                                    <TextDecoration Location="Underline">
                                        <TextDecoration.Pen>
                                            <Pen Brush="{DynamicResource {x:Static joufflu:Brushes.ForegroundBrush}}" Thickness="1">
                                                <Pen.DashStyle>
                                                    <DashStyle Dashes="0,3" />
                                                </Pen.DashStyle>
                                            </Pen>
                                        </TextDecoration.Pen>
                                        <TextDecoration.PenOffset>1</TextDecoration.PenOffset>
                                    </TextDecoration>
                                </TextBlock.TextDecorations>
                            </TextBlock>
                            <Button
                                Grid.Column="1"
                                Command="{Binding EditCommand}"
                                Style="{DynamicResource EmbeddedButton}">
                                <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.Pencil}" />
                            </Button>
                        </Grid>

                        <Grid x:Name="EditContainer">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditing}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <TextBox x:Name="PART_TextBox">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding ValidateCommand}" />
                                    <KeyBinding Key="Esc" Command="{Binding CancelCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>

                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <Button Command="{Binding CancelCommand}" Style="{DynamicResource EmbeddedButton}">
                                    <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.x}" />
                                </Button>
                                <Button Command="{Binding ValidateCommand}" Style="{DynamicResource EmbeddedButton}">
                                    <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.Check}" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>