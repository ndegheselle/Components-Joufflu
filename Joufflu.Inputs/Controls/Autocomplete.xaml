<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:local="clr-namespace:Joufflu.Inputs.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Joufflu;component/Styles/Natives/DataInput/TextBox.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Joufflu;component/Styles/Natives/DataInput/ListBox.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--  The text box keeps the keyboard focus while the arrow keys walk the list, so no row may take it  -->
    <Style
        x:Key="AutocompleteSuggestionStyle"
        BasedOn="{StaticResource {x:Type ListBoxItem}}"
        TargetType="{x:Type ListBoxItem}">
        <Setter Property="Focusable" Value="False" />
    </Style>

    <Style
        x:Key="{x:Type local:Autocomplete}"
        BasedOn="{StaticResource TextBoxDefaultStyle}"
        TargetType="{x:Type local:Autocomplete}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:Autocomplete}">
                    <Grid>
                        <Border
                            x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource {x:Static joufflu:Dimensions.CornerRadius}}" />

                        <Grid Margin="{TemplateBinding Padding}" ClipToBounds="True">
                            <!--
                                Completion drawn under the text box : the typed part is transparent, so what the
                                highlighted item adds lands exactly where the caret is, in the same font
                            -->
                            <StackPanel
                                x:Name="CompletionText"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False"
                                Opacity="0.65"
                                Orientation="Horizontal">
                                <TextBlock Foreground="Transparent" Text="{TemplateBinding Text}" />
                                <TextBlock Foreground="{TemplateBinding Foreground}" Text="{TemplateBinding Completion}" />
                            </StackPanel>

                            <!--  The control draws the chrome, the box carries nothing but the text  -->
                            <TextBox
                                x:Name="PART_EditableTextBox"
                                Padding="0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                Background="Transparent"
                                BorderThickness="0"
                                CaretBrush="{TemplateBinding Foreground}"
                                Focusable="True"
                                Foreground="{TemplateBinding Foreground}"
                                Style="{x:Null}"
                                Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.Template>
                                    <ControlTemplate TargetType="TextBox">
                                        <ScrollViewer
                                            Name="PART_ContentHost"
                                            Focusable="False"
                                            HorizontalScrollBarVisibility="Hidden"
                                            Template="{StaticResource TextBoxScrollViewerTemplate}"
                                            VerticalScrollBarVisibility="Hidden" />
                                    </ControlTemplate>
                                </TextBox.Template>
                            </TextBox>
                        </Grid>

                        <!--  Popup showing the suggestions  -->
                        <Popup
                            x:Name="PART_Popup"
                            AllowsTransparency="True"
                            Focusable="False"
                            IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                            Placement="Bottom"
                            PopupAnimation="Slide"
                            StaysOpen="False">
                            <!--  A popup renders in its own tree : it is given the theme colours rather than inheriting them  -->
                            <Border
                                x:Name="DropDownBorder"
                                MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                Margin="0,1,0,0"
                                Background="{DynamicResource {x:Static joufflu:Brushes.BackgroundBrush}}"
                                BorderBrush="{DynamicResource {x:Static joufflu:Brushes.BorderBrush}}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource {x:Static joufflu:Dimensions.CornerRadius}}"
                                SnapsToDevicePixels="True"
                                TextElement.FontSize="{TemplateBinding FontSize}"
                                TextElement.Foreground="{DynamicResource {x:Static joufflu:Brushes.ForegroundBrush}}">
                                <ListBox
                                    x:Name="PART_Suggestions"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Focusable="False"
                                    ItemContainerStyle="{StaticResource AutocompleteSuggestionStyle}"
                                    ItemTemplate="{TemplateBinding ItemTemplate}"
                                    ItemsSource="{Binding Suggestions, RelativeSource={RelativeSource TemplatedParent}}"
                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                            </Border>
                        </Popup>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource {x:Static joufflu:Brushes.DangerBrush}}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
