<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fonts="clr-namespace:Joufflu.Assets.Fonts;assembly=Joufflu"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:local="clr-namespace:Joufflu.Inputs.Controls"
    xmlns:toolkit="clr-namespace:Joufflu.Toolkit;assembly=Joufflu">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Joufflu;component/Styles/Natives/DataInput/TextBox.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Joufflu;component/Styles/Natives/DataInput/ComboBox.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Joufflu;component/Styles/Natives/Actions/Button.named.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Joufflu;component/Styles/Natives/DataDisplay/Typography.named.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Joufflu.Inputs;component/Controls/ComboBoxSearch.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style
        x:Key="{x:Type local:ComboBoxTags}"
        BasedOn="{StaticResource {x:Type local:ComboBoxSearch}}"
        TargetType="{x:Type local:ComboBoxTags}">
        <Style.Resources>
            <local:DisplayMemberPathConverter x:Key="DisplayMemberPathConverter" />
        </Style.Resources>
        <Setter Property="Height" Value="auto" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ComboBoxTags}">
                    <Grid Tag="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                        <Border
                            x:Name="Border"
                            MinHeight="{DynamicResource {x:Static joufflu:Dimensions.HeightMd}}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource {x:Static joufflu:Dimensions.CornerRadius}}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <WrapPanel VerticalAlignment="Center">
                                <ItemsControl
                                    x:Name="TagsPresenter"
                                    Margin="2"
                                    ItemsSource="{Binding InternalSelectedItems, RelativeSource={RelativeSource TemplatedParent}}"
                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!--  Xs height + 2px tag margin + 2px presenter margin = HeightMd on a single row  -->
                                            <ContentControl Height="{DynamicResource {x:Static joufflu:Dimensions.HeightSm}}">
                                                <Border
                                                    Margin="1"
                                                    Background="{Binding BorderBrush, ElementName=Border}"
                                                    CornerRadius="{DynamicResource {x:Static joufflu:Dimensions.CornerRadius}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock.Text>
                                                                <MultiBinding Converter="{StaticResource DisplayMemberPathConverter}">
                                                                    <Binding />
                                                                    <Binding Path="DisplayMemberPath" RelativeSource="{RelativeSource AncestorType=local:ComboBoxTags}" />
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                        <Button
                                                            Margin="3"
                                                            Command="{Binding RemoveSelectedCommand, RelativeSource={RelativeSource AncestorType=local:ComboBoxTags}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource EmbeddedButton}">
                                                            <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.x}" />
                                                        </Button>
                                                    </StackPanel>
                                                </Border>
                                            </ContentControl>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Grid
                                    x:Name="SearchContainer"
                                    Margin="4"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center">
                                    <TextBox
                                        x:Name="PART_EditableTextBox"
                                        Height="auto"
                                        MinWidth="50"
                                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                        Background="{TemplateBinding Background}"
                                        Focusable="True"
                                        Foreground="{TemplateBinding Foreground}"
                                        IsReadOnly="{TemplateBinding IsReadOnly}"
                                        Visibility="Hidden">
                                        <TextBox.Template>
                                            <ControlTemplate TargetType="TextBox">
                                                <ScrollViewer
                                                    Name="PART_ContentHost"
                                                    Focusable="False"
                                                    HorizontalScrollBarVisibility="Hidden"
                                                    Template="{StaticResource TextBoxScrollViewerTemplate}"
                                                    VerticalScrollBarVisibility="Hidden" />
                                            </ControlTemplate>
                                        </TextBox.Template>
                                    </TextBox>


                                    <TextBlock
                                        x:Name="PlaceholderText"
                                        IsHitTestVisible="False"
                                        Style="{StaticResource Muted}"
                                        Text="Search ..."
                                        Visibility="Collapsed" />
                                </Grid>
                            </WrapPanel>

                            <!--  Chevron handle : the tags and the text box take the control surface, so the drop down needs a target of its own  -->
                            <ToggleButton
                                x:Name="ToggleButton"
                                Grid.Column="1"
                                Width="{DynamicResource {x:Static joufflu:Dimensions.HeightEmbedded}}"
                                Height="{DynamicResource {x:Static joufflu:Dimensions.HeightEmbedded}}"
                                VerticalAlignment="Center"
                                toolkit:Derive.Margin="{x:Static joufflu:Dimensions.InputPaddingMd}"
                                toolkit:Derive.MarginFactor="0,0,1,0"
                                ClickMode="Press"
                                Focusable="False"
                                Foreground="{TemplateBinding Foreground}"
                                IsChecked="{Binding Path=IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                Template="{StaticResource ComboBoxChevronToggleButtonTemplate}" />
                        </Grid>

                        <!--  Popup showing items  -->
                        <Popup
                            x:Name="PART_Popup"
                            AllowsTransparency="True"
                            Focusable="False"
                            IsOpen="{TemplateBinding ComboBox.IsDropDownOpen}"
                            Placement="Bottom"
                            PopupAnimation="Slide">
                            <Grid
                                x:Name="DropDown"
                                MinWidth="{TemplateBinding FrameworkElement.ActualWidth}"
                                MaxHeight="{TemplateBinding ComboBox.MaxDropDownHeight}"
                                SnapsToDevicePixels="True">
                                <Border
                                    x:Name="DropDownBorder"
                                    Margin="0,1,0,0"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{DynamicResource {x:Static joufflu:Dimensions.CornerRadius}}">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!--  No tag : the search area carries the control Padding, otherwise the tags provide the spacing  -->
                        <DataTrigger Binding="{Binding InternalSelectedItems.Count, RelativeSource={RelativeSource TemplatedParent}}" Value="0">
                            <Setter TargetName="SearchContainer" Property="Margin" Value="{Binding Padding, RelativeSource={RelativeSource TemplatedParent}}" />
                        </DataTrigger>
                        <!--  Show the placeholder only while empty and unfocused (Text is "" initially, null after blur)  -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsKeyboardFocusWithin" Value="False" />
                                <Condition Property="Text" Value="" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsKeyboardFocusWithin" Value="False" />
                                <Condition Property="Text" Value="{x:Null}" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="DropDownBorder" Property="FrameworkElement.MinHeight" Value="95" />
                        </Trigger>
                        <Trigger Property="IsGrouping" Value="True">
                            <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
                        </Trigger>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter Property="KeyboardNavigation.IsTabStop" Value="False" />
                            <Setter TargetName="PART_EditableTextBox" Property="UIElement.Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
