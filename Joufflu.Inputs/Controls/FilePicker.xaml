<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fonts="clr-namespace:Joufflu.Assets.Fonts;assembly=Joufflu"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:local="clr-namespace:Joufflu.Inputs.Controls"
    xmlns:toolkit="clr-namespace:Joufflu.Toolkit;assembly=Joufflu">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Joufflu;component/Styles/Natives/Actions/Button.named.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="{x:Type local:FilePicker}">
        <Setter Property="Validation.ErrorTemplate" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:FilePicker}">
                    <Grid DataContext="{Binding RelativeSource={RelativeSource AncestorType=local:FilePicker}}">
                        <TextBox
                            x:Name="ErrorBorder"
                            MinWidth="100"
                            Text="{Binding FilePath, TargetNullValue='', Mode=TwoWay}" />

                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <!--  Clear button  -->
                            <Button
                                x:Name="ClearButton"
                                Width="{DynamicResource {x:Static joufflu:Dimensions.HeightEmbedded}}"
                                Height="{DynamicResource {x:Static joufflu:Dimensions.HeightEmbedded}}"
                                Padding="0"
                                toolkit:Derive.Margin="{x:Static joufflu:Dimensions.InputPaddingMd}"
                                toolkit:Derive.MarginFactor="1,0"
                                Command="{Binding ClearCommand}">
                                <Button.Style>
                                    <Style BasedOn="{StaticResource GhostButton}" TargetType="{x:Type Button}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FilePath}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.x}" />
                            </Button>
                            <Button
                                Margin="-1"
                                toolkit:Sizing.IsSquare="True"
                                Command="{Binding SelectCommand}">
                                <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.File}" />
                            </Button>
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!--  Keeps the clear button flush with the text padding (md is the default set above).  -->
                        <Trigger Property="toolkit:Sizing.Size" Value="xs">
                            <Setter TargetName="ClearButton" Property="toolkit:Derive.Margin" Value="{x:Static joufflu:Dimensions.InputPaddingXs}" />
                        </Trigger>
                        <Trigger Property="toolkit:Sizing.Size" Value="sm">
                            <Setter TargetName="ClearButton" Property="toolkit:Derive.Margin" Value="{x:Static joufflu:Dimensions.InputPaddingSm}" />
                        </Trigger>
                        <Trigger Property="toolkit:Sizing.Size" Value="lg">
                            <Setter TargetName="ClearButton" Property="toolkit:Derive.Margin" Value="{x:Static joufflu:Dimensions.InputPaddingLg}" />
                        </Trigger>

                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="ErrorBorder" Property="BorderBrush" Value="{DynamicResource {x:Static joufflu:Brushes.DangerBrush}}" />
                            <Setter TargetName="ErrorBorder" Property="BorderThickness" Value="{DynamicResource {x:Static joufflu:Dimensions.BorderThickness}}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
