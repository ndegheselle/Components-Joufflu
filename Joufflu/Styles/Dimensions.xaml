<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:joufflu="clr-namespace:Joufflu"
    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <system:Double x:Key="{x:Static joufflu:Dimensions.Thickness}">1</system:Double>
    <Thickness
        x:Key="{x:Static joufflu:Dimensions.BorderThickness}"
        Bottom="{StaticResource {x:Static joufflu:Dimensions.Thickness}}"
        Left="{StaticResource {x:Static joufflu:Dimensions.Thickness}}"
        Right="{StaticResource {x:Static joufflu:Dimensions.Thickness}}"
        Top="{StaticResource {x:Static joufflu:Dimensions.Thickness}}" />

    <system:Double x:Key="{x:Static joufflu:Dimensions.Radius}">4</system:Double>
    <CornerRadius
        x:Key="{x:Static joufflu:Dimensions.CornerRadius}"
        BottomLeft="{StaticResource {x:Static joufflu:Dimensions.Radius}}"
        BottomRight="{StaticResource {x:Static joufflu:Dimensions.Radius}}"
        TopLeft="{StaticResource {x:Static joufflu:Dimensions.Radius}}"
        TopRight="{StaticResource {x:Static joufflu:Dimensions.Radius}}" />

    <system:Double x:Key="{x:Static joufflu:Dimensions.Spacing}">12</system:Double>
    <Thickness 
        x:Key="{x:Static joufflu:Dimensions.SpacingThickness}"
        Bottom="{StaticResource {x:Static joufflu:Dimensions.Spacing}}"
        Left="{StaticResource {x:Static joufflu:Dimensions.Spacing}}"
        Right="{StaticResource {x:Static joufflu:Dimensions.Spacing}}"
        Top="{StaticResource {x:Static joufflu:Dimensions.Spacing}}" />

    <!--  Height of the window title bar  -->
    <system:Double x:Key="{x:Static joufflu:Dimensions.TitleBarHeight}">30</system:Double>
    <Thickness x:Key="{x:Static joufflu:Dimensions.TitleBarHeightOffset}" Top="{StaticResource {x:Static joufflu:Dimensions.TitleBarHeight}}" />

    <!--  Vertical size of single line controls  -->
    <system:Double x:Key="{x:Static joufflu:Dimensions.HeightXs}">24</system:Double>
    <system:Double x:Key="{x:Static joufflu:Dimensions.HeightSm}">28</system:Double>
    <system:Double x:Key="{x:Static joufflu:Dimensions.HeightMd}">32</system:Double>
    <system:Double x:Key="{x:Static joufflu:Dimensions.HeightLg}">40</system:Double>

    <!--  Height of the small "clear" close buttons embedded in other controls (search, combobox, numeric input…); 0.625 of HeightMd  -->
    <system:Double x:Key="{x:Static joufflu:Dimensions.HeightEmbedded}">20</system:Double>

    <!--  Font size  -->
    <system:Double x:Key="{x:Static joufflu:Dimensions.FontSizeXs}">11</system:Double>
    <system:Double x:Key="{x:Static joufflu:Dimensions.FontSizeSm}">12</system:Double>
    <system:Double x:Key="{x:Static joufflu:Dimensions.FontSizeMd}">13</system:Double>
    <system:Double x:Key="{x:Static joufflu:Dimensions.FontSizeLg}">16</system:Double>
    <system:Double x:Key="{x:Static joufflu:Dimensions.FontSizeXl}">24</system:Double>

    <!--  Control paddings  -->
    <Thickness x:Key="{x:Static joufflu:Dimensions.PaddingXs}">6,2</Thickness>
    <Thickness x:Key="{x:Static joufflu:Dimensions.PaddingSm}">9,3</Thickness>
    <Thickness x:Key="{x:Static joufflu:Dimensions.PaddingMd}">12,4</Thickness>
    <Thickness x:Key="{x:Static joufflu:Dimensions.PaddingLg}">18,6</Thickness>

    <!--  Text input paddings (half the control padding's horizontal, tighter than a button)  -->
    <Thickness x:Key="{x:Static joufflu:Dimensions.InputPaddingXs}">3,2</Thickness>
    <Thickness x:Key="{x:Static joufflu:Dimensions.InputPaddingSm}">4.5,3</Thickness>
    <Thickness x:Key="{x:Static joufflu:Dimensions.InputPaddingMd}">6,4</Thickness>
    <Thickness x:Key="{x:Static joufflu:Dimensions.InputPaddingLg}">9,6</Thickness>

    <!--  Opacity applied to controls when IsEnabled="False"  -->
    <system:Double x:Key="{x:Static joufflu:Colors.DisabledOpacity}">0.5</system:Double>

</ResourceDictionary>
