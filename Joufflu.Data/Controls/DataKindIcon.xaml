<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Joufflu.Converters;assembly=Joufflu"
    xmlns:fonts="clr-namespace:Joufflu.Assets.Fonts;assembly=Joufflu"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:local="clr-namespace:Joufflu.Data.Controls">

    <Style TargetType="{x:Type local:DataKindIcon}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:DataKindIcon}">
                    <StackPanel
                        joufflu:Tooltip.Content="{TemplateBinding Kind}"
                        joufflu:Tooltip.Placement="Bottom"
                        Orientation="Horizontal">
                        <fonts:FontIcon VerticalAlignment="Center" Text="{TemplateBinding Glyph}" />
                        <TextBlock
                            Margin="4,0,0,0"
                            VerticalAlignment="Center"
                            Text="{TemplateBinding Kind}"
                            Visibility="{Binding ShowName, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static converters:VisibilityConverter.Default}}" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
