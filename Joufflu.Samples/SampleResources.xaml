<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:Joufflu.Samples.Controls"
    xmlns:customDisplay="clr-namespace:Joufflu.Samples.Views.Feedback"
    xmlns:customFeedback="clr-namespace:Joufflu.Samples.Views.Feedback"
    xmlns:customNav="clr-namespace:Joufflu.Samples.Views.Navigation"
    xmlns:customNavViews="clr-namespace:Joufflu.Samples.Views.Navigation.Views"
    xmlns:dataSamples="clr-namespace:Joufflu.Samples.Views.Data"
    xmlns:fileExplorer="clr-namespace:Joufflu.Samples.Views.FileExplorer"
    xmlns:inputs="clr-namespace:Joufflu.Samples.Views.Inputs"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:nativeActions="clr-namespace:Joufflu.Samples.Views.Natives.Actions"
    xmlns:nativeDisplay="clr-namespace:Joufflu.Samples.Views.Natives.DataDisplay"
    xmlns:nativeFeedback="clr-namespace:Joufflu.Samples.Views.Natives.Feedback"
    xmlns:nativeInput="clr-namespace:Joufflu.Samples.Views.Natives.DataInput"
    xmlns:themesSamples="clr-namespace:Joufflu.Samples.Views.Themes"
    xmlns:toolkit="clr-namespace:Joufflu.Toolkit;assembly=Joufflu"
    xmlns:toolkitSamples="clr-namespace:Joufflu.Samples.Views.Toolkit"
    xmlns:vm="clr-namespace:Joufflu.Samples.ViewModels">

    <!--  Live preview + code snippet card  -->
    <Style TargetType="{x:Type c:CodeExample}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:CodeExample}">
                    <Border Style="{StaticResource Card}">
                        <Grid toolkit:Spacing.Gap="{StaticResource {x:Static joufflu:Dimensions.SpacingThickness}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="{TemplateBinding Title}" />
                                <TextBlock
                                    x:Name="Desc"
                                    Foreground="{DynamicResource {x:Static joufflu:Brushes.Foreground100Brush}}"
                                    Text="{TemplateBinding Description}"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <Border
                                x:Name="ContentArea"
                                Grid.Row="1"
                                Style="{StaticResource CardSecondary}">
                                <ContentPresenter />
                            </Border>

                            <TextBox
                                x:Name="CodeArea"
                                Grid.Row="2"
                                Height="Auto"
                                MaxHeight="320"
                                VerticalAlignment="Stretch"
                                FontFamily="Consolas, Cascadia Mono, monospace"
                                HorizontalScrollBarVisibility="Auto"
                                IsReadOnly="True"
                                Text="{TemplateBinding Code}"
                                TextWrapping="NoWrap" />
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="Code" Value="">
                            <Setter TargetName="CodeArea" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Description" Value="">
                            <Setter TargetName="Desc" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="ContentArea" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  View model → view mapping used by the navigation container and overlays.  -->
    <!--  Only pages that have a view model need a mapping; static pages are navigated to directly.  -->

    <!--  Natives / Actions  -->
    <DataTemplate DataType="{x:Type nativeActions:ButtonSamplesViewModel}">
        <nativeActions:ButtonSamples />
    </DataTemplate>
    <DataTemplate DataType="{x:Type nativeActions:ToggleButtonSamplesViewModel}">
