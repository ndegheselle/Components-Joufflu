<UserControl
    x:Class="Joufflu.Samples.Views.Toolkit.SizingSamples"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:Joufflu.Samples.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fonts="clr-namespace:Joufflu.Assets.Fonts;assembly=Joufflu"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="clr-namespace:Joufflu.Toolkit;assembly=Joufflu"
    xmlns:vm="clr-namespace:Joufflu.Samples.Views.Toolkit"
    d:DataContext="{d:DesignInstance Type=vm:SizingSamplesViewModel}"
    mc:Ignorable="d">
    <ScrollViewer Padding="{StaticResource {x:Static joufflu:Dimensions.SpacingThickness}}" VerticalScrollBarVisibility="Auto">
        <StackPanel

            toolkit:Spacing.Gap="{StaticResource {x:Static joufflu:Dimensions.SpacingThickness}}">
            <TextBlock
                Style="{StaticResource H1}"
                Text="Sizing" />

            <c:CodeExample
                Title="Sizing.Size"
                Code="{Binding SizeCode}"
                Description="The inherited Size attached property (xs / sm / md / lg) scales height, font size and padding. Because it inherits, setting it on a panel sizes every child.">
                <StackPanel toolkit:Spacing.Gap="12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" toolkit:Spacing.Gap="8,0">
                        <Button toolkit:Sizing.Size="xs" VerticalAlignment="Center">xs</Button>
                        <Button toolkit:Sizing.Size="sm" VerticalAlignment="Center">sm</Button>
                        <Button toolkit:Sizing.Size="md" VerticalAlignment="Center">md</Button>
                        <Button toolkit:Sizing.Size="lg" VerticalAlignment="Center">lg</Button>
                    </StackPanel>

                    <StackPanel
                        Width="240"
                        HorizontalAlignment="Left"
                        toolkit:Sizing.Size="lg"
                        toolkit:Spacing.Gap="4">
                        <TextBox Text="Inherited lg" />
                        <ComboBox SelectedIndex="0">
                            <ComboBoxItem>Inherited lg</ComboBoxItem>
                        </ComboBox>
                        <Button>Inherited lg</Button>
                    </StackPanel>
                </StackPanel>
            </c:CodeExample>

            <c:CodeExample
                Title="Sizing.IsSquare"
                Code="{Binding SquareCode}"
                Description="IsSquare forces equal width and height — ideal for single-icon buttons.">
                <StackPanel Orientation="Horizontal" toolkit:Spacing.Gap="8,0">
                    <Button toolkit:Sizing.IsSquare="True" toolkit:Sizing.Size="sm">
                        <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.Leaf}" />
                    </Button>
                    <Button toolkit:Sizing.IsSquare="True" toolkit:Sizing.Size="md">
                        <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.Leaf}" />
                    </Button>
                    <Button toolkit:Sizing.IsSquare="True" toolkit:Sizing.Size="lg">
                        <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.Leaf}" />
                    </Button>
                </StackPanel>
            </c:CodeExample>
        </StackPanel>
    </ScrollViewer>
</UserControl>
