<UserControl
    x:Class="Joufflu.Samples.Views.Toolkit.SpacingSamples"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:Joufflu.Samples.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="clr-namespace:Joufflu.Toolkit;assembly=Joufflu"
    xmlns:vm="clr-namespace:Joufflu.Samples.Views.Toolkit"
    d:DataContext="{d:DesignInstance Type=vm:SpacingSamplesViewModel}"
    mc:Ignorable="d">
    <ScrollViewer Padding="{StaticResource {x:Static joufflu:Dimensions.SpacingThickness}}" VerticalScrollBarVisibility="Auto">
        <StackPanel

            toolkit:Spacing.Gap="{StaticResource {x:Static joufflu:Dimensions.SpacingThickness}}">
            <TextBlock
                Style="{StaticResource H1}"
                Text="Spacing" />

            <c:CodeExample
                Title="Spacing.Gap"
                Code="{Binding GapCode}"
                Description="Gap adds even spacing between the children of a panel — no per-child margins. StackPanel spaces along its orientation; WrapPanel and Grid can space on both axes.">
                <StackPanel toolkit:Spacing.Gap="16">
                    <StackPanel Orientation="Horizontal" toolkit:Spacing.Gap="8">
                        <Button>One</Button>
                        <Button>Two</Button>
                        <Button>Three</Button>
                    </StackPanel>

                    <WrapPanel toolkit:Spacing.Gap="8,12">
                        <Button>Alpha</Button>
                        <Button>Beta</Button>
                        <Button>Gamma</Button>
                        <Button>Delta</Button>
                        <Button>Epsilon</Button>
                    </WrapPanel>

                    <Grid Width="240" HorizontalAlignment="Left" toolkit:Spacing.Gap="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Row="0" Grid.Column="0">A1</Button>
                        <Button Grid.Row="0" Grid.Column="1">A2</Button>
                        <Button Grid.Row="1" Grid.Column="0">B1</Button>
                        <Button Grid.Row="1" Grid.Column="1">B2</Button>
                    </Grid>
                </StackPanel>
            </c:CodeExample>
        </StackPanel>
    </ScrollViewer>
</UserControl>
