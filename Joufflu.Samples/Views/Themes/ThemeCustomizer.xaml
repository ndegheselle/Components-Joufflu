<UserControl
    x:Class="Joufflu.Samples.Views.Themes.ThemeCustomizer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:feedback="clr-namespace:Joufflu.Feedback.Controls;assembly=Joufflu.Feedback"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:inputs="clr-namespace:Joufflu.Inputs.Controls;assembly=Joufflu.Inputs"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="clr-namespace:Joufflu.Toolkit;assembly=Joufflu"
    xmlns:vm="clr-namespace:Joufflu.Samples.Views.Themes"
    d:DataContext="{d:DesignInstance Type=vm:ThemeCustomizerViewModel}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!--  One editable colour row: swatch/hex editor + label  -->
        <DataTemplate x:Key="ColorRowTemplate" DataType="{x:Type vm:ThemeColorEntry}">
            <Grid Margin="0,3" toolkit:Spacing.Gap="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <inputs:ColorPicker Grid.Column="0" Color="{Binding Color, Mode=TwoWay}" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Text="{Binding Label}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>

        <!--  One editable dimension row: label + slider + value  -->
        <DataTemplate x:Key="DimensionRowTemplate" DataType="{x:Type vm:ThemeDimensionEntry}">
            <Grid Margin="0,3" toolkit:Spacing.Gap="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Text="{Binding Label}" />
                <Slider
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    IsSnapToTickEnabled="True"
                    Maximum="{Binding Maximum}"
                    Minimum="{Binding Minimum}"
                    TickFrequency="1"
                    Value="{Binding Value, Mode=TwoWay}" />
                <TextBlock
                    Grid.Column="2"
                    MinWidth="52"
                    VerticalAlignment="Center"
                    TextAlignment="Right">
                    <Run Text="{Binding Value, StringFormat=0}" />
                    <Run Foreground="{DynamicResource {x:Static joufflu:Brushes.Foreground100Brush}}" Text="{Binding Unit, Mode=OneWay}" />
                </TextBlock>
            </Grid>
        </DataTemplate>

        <!--  One size family: a base slider (two for paddings) + the value derived for each size  -->
        <DataTemplate x:Key="ScaleRowTemplate" DataType="{x:Type vm:ThemeScaleEntry}">
            <StackPanel Margin="0,3" toolkit:Spacing.Gap="0,6">
                <TextBlock Style="{StaticResource H4}" Text="{Binding Label}" />
                <!--  Base value(s), the sliders every size is derived from  -->
                <Grid toolkit:Spacing.Gap="10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="{Binding BaseLabel, StringFormat=Base ({0})}" />
                    <StackPanel Grid.Column="1" toolkit:Spacing.Gap="0,4">
                        <Grid toolkit:Spacing.Gap="10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource {x:Static joufflu:Brushes.Foreground100Brush}}"
                                Text="{Binding AxisLabel}" />
                            <Slider
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                IsSnapToTickEnabled="True"
                                Maximum="{Binding Maximum}"
                                Minimum="{Binding Minimum}"
                                TickFrequency="1"
                                Value="{Binding Base, Mode=TwoWay}" />
                            <TextBlock
                                Grid.Column="2"
                                MinWidth="52"
                                VerticalAlignment="Center"
                                TextAlignment="Right">
                                <Run Text="{Binding Base, StringFormat=0}" />
                                <Run Foreground="{DynamicResource {x:Static joufflu:Brushes.Foreground100Brush}}" Text="{Binding Unit, Mode=OneWay}" />
                            </TextBlock>
                        </Grid>
                        <ContentControl Visibility="{Binding HasVertical, Converter={StaticResource BoolToVis}}">
                            <Grid toolkit:Spacing.Gap="10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource {x:Static joufflu:Brushes.Foreground100Brush}}"
                                    Text="V" />
                                <Slider
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    IsSnapToTickEnabled="True"
                                    Maximum="{Binding Maximum}"
                                    Minimum="{Binding Minimum}"
                                    TickFrequency="1"
                                    Value="{Binding VerticalBase, Mode=TwoWay}" />
                                <TextBlock
                                    Grid.Column="2"
                                    MinWidth="52"
                                    VerticalAlignment="Center"
                                    TextAlignment="Right">
                                    <Run Text="{Binding VerticalBase, StringFormat=0}" />
                                    <Run Foreground="{DynamicResource {x:Static joufflu:Brushes.Foreground100Brush}}" Text="{Binding Unit, Mode=OneWay}" />
                                </TextBlock>
                            </Grid>
                        </ContentControl>
                    </StackPanel>
                </Grid>

                <!--  Derived values, one per size  -->
                <ItemsControl Margin="120,0,0,0" ItemsSource="{Binding Steps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ThemeScaleStep}">
                            <Grid toolkit:Spacing.Gap="10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Foreground="{DynamicResource {x:Static joufflu:Brushes.Foreground100Brush}}"
                                    Text="{Binding Label}" />
                                <TextBlock Grid.Column="1" Text="{Binding Display, Mode=OneWay}" />
                                <TextBlock
                                    Grid.Column="2"
                                    Foreground="{DynamicResource {x:Static joufflu:Brushes.Foreground200Brush}}"
                                    Text="{Binding Ratio, StringFormat=×{0}}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

    </UserControl.Resources>

    <Grid Margin="{DynamicResource {x:Static joufflu:Dimensions.SpacingThickness}}" toolkit:Spacing.Gap="{DynamicResource {x:Static joufflu:Dimensions.SpacingThickness}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource H1}" Text="Customize theme" />
            <TextBlock
                Foreground="{DynamicResource {x:Static joufflu:Brushes.Foreground100Brush}}"
                Text="Tweak colours and dimensions and watch the whole gallery update live. Copy or save the generated dictionary and merge it into your app after the Joufflu resources to apply it."
                TextWrapping="Wrap" />
        </StackPanel>

        <!--  Editor | Preview  -->
        <Grid Grid.Row="1" toolkit:Spacing.Gap="{DynamicResource {x:Static joufflu:Dimensions.SpacingThickness}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="440" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Editor  -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <DockPanel>
                    <StackPanel
                        toolkit:Spacing.Gap="8,0"
                        DockPanel.Dock="Top"
                        Orientation="Horizontal">
                        <Button Command="{Binding CopyCommand}" Style="{StaticResource PrimaryButton}">Copy XAML</Button>
                        <Button Command="{Binding SaveCommand}" Style="{StaticResource SecondaryButton}">Save .xaml…</Button>
                        <Button Command="{Binding ResetCommand}" Style="{StaticResource GhostButton}">Reset</Button>
                    </StackPanel>

                    <ScrollViewer Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                        <StackPanel toolkit:Spacing.Gap="{DynamicResource {x:Static joufflu:Dimensions.SpacingThickness}}">
                            <!--  Preset themes  -->
                            <StackPanel toolkit:Spacing.Gap="{DynamicResource {x:Static joufflu:Dimensions.SpacingThickness}}">
                                <TextBlock Style="{StaticResource H2}" Text="Preset themes" />
                                <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ThemePreset}">
                                            <DockPanel>
                                                <StackPanel
                                                    Margin="12,0,0,0"
                                                    toolkit:Spacing.Gap="3,0"
                                                    DockPanel.Dock="Right"
                                                    Orientation="Horizontal">
                                                    <Border
                                                        Width="10"
                                                        Height="18"
                                                        Background="{Binding Primary}"
                                                        CornerRadius="2" />
                                                    <Border
                                                        Width="10"
                                                        Height="18"
                                                        Background="{Binding Secondary}"
                                                        CornerRadius="2" />
                                                    <Border
                                                        Width="10"
                                                        Height="18"
                                                        Background="{Binding Accent}"
                                                        CornerRadius="2" />
                                                    <Border
                                                        Width="10"
                                                        Height="18"
                                                        Background="{Binding Neutral}"
                                                        CornerRadius="2" />
                                                </StackPanel>
                                                <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <!--  Colours  -->
                            <StackPanel toolkit:Spacing.Gap="{DynamicResource {x:Static joufflu:Dimensions.SpacingThickness}}">
                                <TextBlock Style="{StaticResource H2}" Text="Colours" />
                                <ItemsControl ItemsSource="{Binding ColorGroups}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ThemeColorGroup}">
                                            <StackPanel Margin="0,0,0,10">
                                                <TextBlock Style="{StaticResource H4}" Text="{Binding Header}" />
                                                <ItemsControl ItemTemplate="{StaticResource ColorRowTemplate}" ItemsSource="{Binding Colors}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!--  Dimensions  -->
                            <StackPanel toolkit:Spacing.Gap="0,10">
                                <TextBlock Style="{StaticResource H2}" Text="Dimensions" />
                                <ItemsControl ItemsSource="{Binding DimensionGroups}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ThemeDimensionGroup}">
                                            <StackPanel Margin="0,0,0,10">
                                                <TextBlock Style="{StaticResource H4}" Text="{Binding Header}" />
                                                <ItemsControl ItemTemplate="{StaticResource DimensionRowTemplate}" ItemsSource="{Binding Dimensions}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl ItemTemplate="{StaticResource ScaleRowTemplate}" ItemsSource="{Binding Scales}">
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Margin" Value="0,0,0,10" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!--  Preview  -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel toolkit:Spacing.Gap="{DynamicResource {x:Static joufflu:Dimensions.SpacingThickness}}">

                    <!--  Semantic swatches  -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel toolkit:Spacing.Gap="0,10">
                            <TextBlock Style="{StaticResource H3}" Text="Palette" />
                            <WrapPanel toolkit:Spacing.Gap="8,8">
                                <Border
                                    Width="120"
                                    Height="56"
                                    Background="{DynamicResource {x:Static joufflu:Brushes.PrimaryBrush}}"
                                    CornerRadius="{DynamicResource {x:Static joufflu:Dimensions.CornerRadius}}">
                                    <TextBlock
                                        Margin="8"
                                        VerticalAlignment="Bottom"
                                        Foreground="{DynamicResource {x:Static joufflu:Brushes.PrimaryContentBrush}}"
                                        Text="Primary" />
                                </Border>
                                <Border
                                    Width="120"
                                    Height="56"
                                    Background="{DynamicResource {x:Static joufflu:Brushes.SecondaryBrush}}"
                                    CornerRadius="{DynamicResource {x:Static joufflu:Dimensions.CornerRadius}}">
                                    <TextBlock
                                        Margin="8"
                                        VerticalAlignment="Bottom"
                                        Foreground="{DynamicResource {x:Static joufflu:Brushes.SecondaryContentBrush}}"
                                        Text="Secondary" />
                                </Border>
                                <Border
                                    Width="120"
                                    Height="56"
                                    Background="{DynamicResource {x:Static joufflu:Brushes.SuccessBrush}}"
                                    CornerRadius="{DynamicResource {x:Static joufflu:Dimensions.CornerRadius}}">
                                    <TextBlock
                                        Margin="8"
                                        VerticalAlignment="Bottom"
                                        Foreground="{DynamicResource {x:Static joufflu:Brushes.SuccessContentBrush}}"
                                        Text="Success" />
                                </Border>
                                <Border
                                    Width="120"
                                    Height="56"
                                    Background="{DynamicResource {x:Static joufflu:Brushes.InfoBrush}}"
                                    CornerRadius="{DynamicResource {x:Static joufflu:Dimensions.CornerRadius}}">
                                    <TextBlock
                                        Margin="8"
                                        VerticalAlignment="Bottom"
                                        Foreground="{DynamicResource {x:Static joufflu:Brushes.InfoContentBrush}}"
                                        Text="Info" />
                                </Border>
                                <Border
                                    Width="120"
                                    Height="56"
                                    Background="{DynamicResource {x:Static joufflu:Brushes.WarningBrush}}"
                                    CornerRadius="{DynamicResource {x:Static joufflu:Dimensions.CornerRadius}}">
                                    <TextBlock
                                        Margin="8"
                                        VerticalAlignment="Bottom"
                                        Foreground="{DynamicResource {x:Static joufflu:Brushes.WarningContentBrush}}"
                                        Text="Warning" />
                                </Border>
                                <Border
                                    Width="120"
                                    Height="56"
                                    Background="{DynamicResource {x:Static joufflu:Brushes.DangerBrush}}"
                                    CornerRadius="{DynamicResource {x:Static joufflu:Dimensions.CornerRadius}}">
                                    <TextBlock
                                        Margin="8"
                                        VerticalAlignment="Bottom"
                                        Foreground="{DynamicResource {x:Static joufflu:Brushes.DangerContentBrush}}"
                                        Text="Danger" />
                                </Border>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!--  Buttons  -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel toolkit:Spacing.Gap="0,10">
                            <TextBlock Style="{StaticResource H3}" Text="Buttons" />
                            <WrapPanel toolkit:Spacing.Gap="8,8">
                                <Button>Default</Button>
                                <Button Style="{StaticResource PrimaryButton}">Primary</Button>
                                <Button Style="{StaticResource SecondaryButton}">Secondary</Button>
                                <Button Style="{StaticResource SuccessButton}">Success</Button>
                                <Button Style="{StaticResource DangerButton}">Danger</Button>
                                <Button Style="{StaticResource GhostButton}">Ghost</Button>
                                <Button IsEnabled="False">Disabled</Button>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!--  Sizes (one control per size variant so the height/font-size sliders have visible targets)  -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel toolkit:Spacing.Gap="0,10">
                            <TextBlock Style="{StaticResource H3}" Text="Sizes" />
                            <WrapPanel VerticalAlignment="Center" toolkit:Spacing.Gap="8,8">
                                <Button toolkit:Sizing.Size="xs" Style="{StaticResource PrimaryButton}">Extra small</Button>
                                <Button toolkit:Sizing.Size="sm" Style="{StaticResource PrimaryButton}">Small</Button>
                                <Button toolkit:Sizing.Size="md" Style="{StaticResource PrimaryButton}">Medium</Button>
                                <Button toolkit:Sizing.Size="lg" Style="{StaticResource PrimaryButton}">Large</Button>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!--  Inputs  -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel toolkit:Spacing.Gap="0,10">
                            <TextBlock Style="{StaticResource H3}" Text="Inputs" />
                            <WrapPanel toolkit:Spacing.Gap="12,10">
                                <TextBox Width="180" Text="Editable text" />
                                <ComboBox Width="160" SelectedIndex="0">
                                    <ComboBoxItem>First option</ComboBoxItem>
                                    <ComboBoxItem>Second option</ComboBoxItem>
                                    <ComboBoxItem>Third option</ComboBoxItem>
                                </ComboBox>
                                <CheckBox
                                    VerticalAlignment="Center"
                                    Content="Checkbox"
                                    IsChecked="True" />
                                <StackPanel
                                    VerticalAlignment="Center"
                                    toolkit:Spacing.Gap="8,0"
                                    Orientation="Horizontal">
                                    <RadioButton Content="One" IsChecked="True" />
                                    <RadioButton Content="Two" />
                                </StackPanel>
                            </WrapPanel>
                            <Slider
                                Maximum="100"
                                Minimum="0"
                                Value="60" />
                            <ProgressBar
                                Height="8"
                                Maximum="100"
                                Value="60" />
                        </StackPanel>
                    </Border>

                    <!--  Surface layers + badges  -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel toolkit:Spacing.Gap="0,10">
                            <TextBlock Style="{StaticResource H3}" Text="Surfaces &amp; badges" />
                            <Border Style="{StaticResource Card}">
                                <StackPanel toolkit:Spacing.Gap="0,8">
                                    <TextBlock Text="Elevated surface (Background 100)" />
                                    <Border Style="{StaticResource CardSecondary}">
                                        <TextBlock Foreground="{DynamicResource {x:Static joufflu:Brushes.Foreground100Brush}}" Text="Selected surface (Background 200)" />
                                    </Border>
                                    <WrapPanel toolkit:Spacing.Gap="8,8">
                                        <feedback:Badge>Default</feedback:Badge>
                                        <feedback:Badge toolkit:Sizing.Size="xs">Small</feedback:Badge>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!--  Generated dictionary  -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel toolkit:Spacing.Gap="0,10">
                            <TextBlock Style="{StaticResource H3}" Text="Generated dictionary" />
                            <Border Style="{StaticResource CardSecondary}">
                                <TextBox
                                    MaxHeight="360"
                                    MinHeight="200"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontFamily="Consolas, Cascadia Mono, monospace"
                                    Foreground="{DynamicResource {x:Static joufflu:Brushes.Foreground100Brush}}"
                                    HorizontalScrollBarVisibility="Auto"
                                    IsReadOnly="True"
                                    Text="{Binding GeneratedXaml, Mode=OneWay}"
                                    TextWrapping="NoWrap"
                                    VerticalScrollBarVisibility="Auto" />
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
