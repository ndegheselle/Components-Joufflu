<UserControl
    x:Class="Joufflu.Samples.Views.Data.SchemaSamples"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:Joufflu.Samples.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:jodels="clr-namespace:Joufflu.Data.Model;assembly=Joufflu.Data"
    xmlns:jata="clr-namespace:Joufflu.Data.Controls;assembly=Joufflu.Data"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="clr-namespace:Joufflu.Toolkit;assembly=Joufflu"
    xmlns:vm="clr-namespace:Joufflu.Samples.Views.Data"
    d:DataContext="{d:DesignInstance Type=vm:SchemaSamplesViewModel}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Joufflu;component/Styles/Natives/DataDisplay/TreeView.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer Padding="{StaticResource {x:Static joufflu:Dimensions.SpacingThickness}}" VerticalScrollBarVisibility="Auto">
        <StackPanel toolkit:Spacing.Gap="{StaticResource {x:Static joufflu:Dimensions.SpacingThickness}}">
            <TextBlock Style="{StaticResource H1}" Text="Schema" />

            <Button Command="{Binding TestCommand}">Test</Button>

            <TreeView ItemsSource="{Binding Node.Properties}">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="{x:Type TreeViewItem}" BasedOn="{StaticResource TreeViewItemStyle}">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.Resources>
                    <HierarchicalDataTemplate DataType="{x:Type jodels:DataArray}" ItemsSource="{Binding Items}">
                        <StackPanel Orientation="Horizontal" toolkit:Spacing.Gap="4">
                            <jata:DataIcon Type="{Binding Type}" />
                            <TextBlock Text="{Binding Key}" />
                        </StackPanel>
                    </HierarchicalDataTemplate>
                    <HierarchicalDataTemplate DataType="{x:Type jodels:DataObject}" ItemsSource="{Binding Properties}">
                        <StackPanel Orientation="Horizontal" toolkit:Spacing.Gap="4">
                            <jata:DataIcon Type="{Binding Type}" />
                            <TextBlock Text="{Binding Key}" />
                        </StackPanel>
                    </HierarchicalDataTemplate>
                    <DataTemplate DataType="{x:Type jodels:DataArrayControl}">
                        <Button Command="{Binding AddCommand}">Add</Button>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type jodels:DataValue}">
                        <StackPanel Orientation="Horizontal" toolkit:Spacing.Gap="4">
                            <jata:DataIcon Type="{Binding Type}" />
                            <TextBlock Text="{Binding Key}" />
                        </StackPanel>
                    </DataTemplate>
                </TreeView.Resources>
            </TreeView>
        </StackPanel>
    </ScrollViewer>
</UserControl>
