<UserControl
    x:Class="Joufflu.Samples.Views.Data.SchemaSamples"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:Joufflu.Samples.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:data="clr-namespace:Joufflu.Data.Controls;assembly=Joufflu.Data"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="clr-namespace:Joufflu.Toolkit;assembly=Joufflu"
    xmlns:vm="clr-namespace:Joufflu.Samples.Views.Data"
    d:DataContext="{d:DesignInstance Type=vm:SchemaSamplesViewModel}"
    mc:Ignorable="d">
    <ScrollViewer Padding="{StaticResource {x:Static joufflu:Dimensions.SpacingThickness}}" VerticalScrollBarVisibility="Auto">
        <StackPanel toolkit:Spacing.Gap="{StaticResource {x:Static joufflu:Dimensions.SpacingThickness}}">
            <TextBlock Style="{StaticResource H1}" Text="Schema" />

            <c:CodeExample
                Title="Filling a value in"
                Code="{Binding DataCode}"
                Description="Fills a value in against a schema, one row per value, each edited by the widget its kind calls for. A property the schema does not require is left out until its checkbox is ticked. The link button reads a value from somewhere else instead of typing one — a reference stands where a value stands, whatever the declared type.">
                <StackPanel toolkit:Spacing.Gap="8">
                    <data:DataEditor
                        Json="{Binding ValueJson, Mode=TwoWay}"
                        References="{Binding References}"
                        Schema="{Binding OrderSchema}" />

                    <TextBlock Style="{StaticResource Muted}" Text="What the editor writes back" />
                    <TextBox
                        MinHeight="80"
                        AcceptsReturn="True"
                        FontFamily="Consolas"
                        IsReadOnly="True"
                        Text="{Binding ValuePreview, Mode=OneWay}"
                        VerticalScrollBarVisibility="Auto" />
                </StackPanel>
            </c:CodeExample>

            <c:CodeExample
                Title="Writing a schema"
                Code="{Binding SchemaCode}"
                Description="Writes the schema itself : a name, what the value holds, whether a caller may leave it out, and what is said of it. An enumeration takes its options one per line. The read-only view below shows the same schema as the shape it describes.">
                <Grid toolkit:Spacing.Gap="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>

                    <data:SchemaEditor Json="{Binding SchemaJson, Mode=TwoWay}" />
                    <data:SchemaView Grid.Row="1" SchemaJson="{Binding SchemaJson}" />

                    <TextBox
                        Grid.Row="2"
                        MinHeight="80"
                        AcceptsReturn="True"
                        FontFamily="Consolas"
                        IsReadOnly="True"
                        Text="{Binding SchemaPreview, Mode=OneWay}"
                        VerticalScrollBarVisibility="Auto" />
                </Grid>
            </c:CodeExample>
        </StackPanel>
    </ScrollViewer>
</UserControl>
