<UserControl
    x:Class="Joufflu.Samples.Views.Feedback.ToastSamples"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:Joufflu.Samples.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:extensions="clr-namespace:Joufflu.Extensions;assembly=Joufflu"
    xmlns:feedback="clr-namespace:Joufflu.Feedback.Controls;assembly=Joufflu.Feedback"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="clr-namespace:Joufflu.Toolkit;assembly=Joufflu"
    xmlns:vm="clr-namespace:Joufflu.Samples.Views.Feedback"
    d:DataContext="{d:DesignInstance Type=vm:ToastSamplesViewModel}"
    mc:Ignorable="d">
    <ScrollViewer Padding="{StaticResource {x:Static joufflu:Dimensions.SpacingThickness}}" VerticalScrollBarVisibility="Auto">
        <StackPanel toolkit:Spacing.Gap="{StaticResource {x:Static joufflu:Dimensions.SpacingThickness}}">
            <TextBlock Style="{StaticResource H1}" Text="Toast" />

            <c:CodeExample
                Title="Toast types"
                Code="{Binding Code}"
                Description="Toasts stack in a corner of the window, always above page content and overlays, and auto-dismiss after a few seconds (unless sticky).">
                <WrapPanel toolkit:Spacing.Gap="8,8">
                    <Button
                        Command="{Binding InfoCommand}"
                        Content="Info"
                        Style="{StaticResource InfoButton}" />
                    <Button
                        Command="{Binding SuccessCommand}"
                        Content="Success"
                        Style="{StaticResource SuccessButton}" />
                    <Button
                        Command="{Binding WarningCommand}"
                        Content="Warning"
                        Style="{StaticResource WarningButton}" />
                    <Button
                        Command="{Binding ErrorCommand}"
                        Content="Error"
                        Style="{StaticResource DangerButton}" />
                    <Button Command="{Binding StickyCommand}" Content="Sticky" />
                    <Button Command="{Binding StackCommand}" Content="Stack ×3" />
                </WrapPanel>
            </c:CodeExample>

            <c:CodeExample
                Title="Position"
                Code="{Binding PositionCode}"
                Description="The ToastContainer wrapping the app stacks its toasts in the corner given by Position. The newest toast always sits closest to that corner. Pick one and raise a toast above to see it move.">
                <ComboBox
                    Width="180"
                    HorizontalAlignment="Left"
                    ItemsSource="{extensions:EnumValuesExtension {x:Type feedback:ToastPosition}}"
                    SelectedItem="{Binding Position, Mode=TwoWay}" />
            </c:CodeExample>
        </StackPanel>
    </ScrollViewer>
</UserControl>
