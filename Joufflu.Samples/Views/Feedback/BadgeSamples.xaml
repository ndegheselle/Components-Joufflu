<UserControl
    x:Class="Joufflu.Samples.Views.Feedback.BadgeSamples"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:Joufflu.Samples.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:feedback="clr-namespace:Joufflu.Feedback.Controls;assembly=Joufflu.Feedback"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="clr-namespace:Joufflu.Toolkit;assembly=Joufflu"
    xmlns:vm="clr-namespace:Joufflu.Samples.Views.Feedback"
    d:DataContext="{d:DesignInstance Type=vm:BadgeSamplesViewModel}"
    mc:Ignorable="d">
    <ScrollViewer Padding="{StaticResource {x:Static joufflu:Dimensions.SpacingThickness}}" VerticalScrollBarVisibility="Auto">
        <StackPanel toolkit:Spacing.Gap="{StaticResource {x:Static joufflu:Dimensions.SpacingThickness}}">
            <TextBlock Style="{StaticResource H1}" Text="Badge" />

            <c:CodeExample
                Title="Variants"
                Code="{Binding VariantsCode}"
                Description="A pill themed from the semantic brushes. Pick a variant with the Variant property.">
                <WrapPanel toolkit:Spacing.Gap="8,0">
                    <feedback:Badge>Default</feedback:Badge>
                    <feedback:Badge Variant="Primary">Primary</feedback:Badge>
                    <feedback:Badge Variant="Secondary">Secondary</feedback:Badge>
                    <feedback:Badge Variant="Success">Success</feedback:Badge>
                    <feedback:Badge Variant="Info">Info</feedback:Badge>
                    <feedback:Badge Variant="Warning">Warning</feedback:Badge>
                    <feedback:Badge Variant="Danger">Danger</feedback:Badge>
                </WrapPanel>
            </c:CodeExample>

            <c:CodeExample
                Title="Sizes"
                Code="{Binding SizesCode}"
                Description="Sized through the inherited Sizing.Size attached property.">
                <StackPanel toolkit:Spacing.Gap="8,0" Orientation="Horizontal">
                    <feedback:Badge toolkit:Sizing.Size="xs" Variant="Primary">xs</feedback:Badge>
                    <feedback:Badge toolkit:Sizing.Size="sm" Variant="Primary">sm</feedback:Badge>
                    <feedback:Badge toolkit:Sizing.Size="md" Variant="Primary">md</feedback:Badge>
                    <feedback:Badge toolkit:Sizing.Size="lg" Variant="Primary">lg</feedback:Badge>
                </StackPanel>
            </c:CodeExample>
        </StackPanel>
    </ScrollViewer>
</UserControl>
