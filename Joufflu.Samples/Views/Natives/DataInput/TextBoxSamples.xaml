<UserControl
    x:Class="Joufflu.Samples.Views.Natives.DataInput.TextBoxSamples"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:Joufflu.Samples.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="clr-namespace:Joufflu.Toolkit;assembly=Joufflu"
    xmlns:vm="clr-namespace:Joufflu.Samples.Views.Natives.DataInput"
    d:DataContext="{d:DesignInstance Type=vm:TextBoxSamplesViewModel}"
    mc:Ignorable="d">
    <ScrollViewer Padding="{StaticResource {x:Static joufflu:Dimensions.SpacingThickness}}" VerticalScrollBarVisibility="Auto">
        <StackPanel toolkit:Spacing.Gap="{StaticResource {x:Static joufflu:Dimensions.SpacingThickness}}">
            <TextBlock Style="{StaticResource H1}" Text="Text box" />

            <c:CodeExample
                Title="Text input"
                Code="{Binding TextCode}"
                Description="A standard TextBox bound to the view model.">
                <StackPanel toolkit:Spacing.Gap="4">
                    <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox IsEnabled="False" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </c:CodeExample>

            <c:CodeExample
                Title="Sizes"
                Code="{Binding SizesCode}"
                Description="Height, font size and padding follow the inherited Sizing.Size.">
                <StackPanel toolkit:Spacing.Gap="4">
                    <TextBox toolkit:Sizing.Size="sm" Text="Small" />
                    <TextBox Text="Medium" />
                    <TextBox toolkit:Sizing.Size="lg" Text="Large" />
                </StackPanel>
            </c:CodeExample>

            <c:CodeExample
                Title="Password &amp; multi-line"
                Code="{Binding OtherCode}"
                Description="PasswordBox shares the TextBox styling; a TextBox becomes multi-line with AcceptsReturn.">
                <StackPanel toolkit:Spacing.Gap="4">
                    <PasswordBox Password="secret" />
                    <TextBox
                        Height="70"
                        VerticalContentAlignment="Top"
                        AcceptsReturn="True"
                        Text="Multi-line&#x0a;text box"
                        TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Auto" />
                </StackPanel>
            </c:CodeExample>
        </StackPanel>
    </ScrollViewer>
</UserControl>
