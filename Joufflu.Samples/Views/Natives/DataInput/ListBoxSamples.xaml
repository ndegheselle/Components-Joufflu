<UserControl
    x:Class="Joufflu.Samples.Views.Natives.DataInput.ListBoxSamples"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:Joufflu.Samples.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="clr-namespace:Joufflu.Toolkit;assembly=Joufflu"
    xmlns:vm="clr-namespace:Joufflu.Samples.Views.Natives.DataInput"
    d:DataContext="{d:DesignInstance Type=vm:ListBoxSamplesViewModel}"
    mc:Ignorable="d">
    <ScrollViewer Padding="{StaticResource {x:Static joufflu:Dimensions.SpacingThickness}}" VerticalScrollBarVisibility="Auto">
        <StackPanel toolkit:Spacing.Gap="{StaticResource {x:Static joufflu:Dimensions.SpacingThickness}}">
            <TextBlock
                Style="{StaticResource H1}"
                Text="List box" />

            <c:CodeExample
                Title="Single selection"
                Code="{Binding Code}"
                Description="A scrollable list bound to ItemsSource.">
                <ListBox
                    Height="160"
                    ItemsSource="{Binding Items}"
                    SelectedIndex="0" />
            </c:CodeExample>

            <c:CodeExample
                Title="Multiple selection"
                Code="{Binding MultiCode}"
                Description="SelectionMode=&quot;Extended&quot; lets the user pick several rows with Ctrl / Shift.">
                <ListBox
                    Height="160"
                    ItemsSource="{Binding Items}"
                    SelectionMode="Extended" />
            </c:CodeExample>
        </StackPanel>
    </ScrollViewer>
</UserControl>
