<UserControl
    x:Class="Joufflu.Samples.Views.Natives.DataInput.ComboBoxSamples"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:Joufflu.Samples.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="clr-namespace:Joufflu.Toolkit;assembly=Joufflu"
    xmlns:vm="clr-namespace:Joufflu.Samples.Views.Natives.DataInput"
    d:DataContext="{d:DesignInstance Type=vm:ComboBoxSamplesViewModel}"
    mc:Ignorable="d">
    <ScrollViewer Padding="{StaticResource {x:Static joufflu:Dimensions.SpacingThickness}}" VerticalScrollBarVisibility="Auto">
        <StackPanel

            toolkit:Spacing.Gap="{StaticResource {x:Static joufflu:Dimensions.SpacingThickness}}">
            <TextBlock
                Style="{StaticResource H1}"
                Text="Combo box" />

            <c:CodeExample
                Title="Selection"
                
                Code="{Binding SelectionCode}"
                Description="Bind ItemsSource and SelectedItem to the view model.">
                <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}" />
            </c:CodeExample>

            <c:CodeExample
                Title="Editable"
                
                Code="{Binding EditableCode}"
                Description="IsEditable lets the user type a value alongside the drop-down.">
                <ComboBox
                    IsEditable="True"
                    ItemsSource="{Binding Options}"
                    Text="{Binding SelectedOption}" />
            </c:CodeExample>

            <c:CodeExample
                Title="Sizes"
                
                Code="{Binding SizesCode}"
                Description="Sized through the inherited Sizing.Size.">
                <StackPanel toolkit:Spacing.Gap="4">
                    <ComboBox ItemsSource="{Binding Options}" SelectedIndex="0" toolkit:Sizing.Size="sm" />
                    <ComboBox ItemsSource="{Binding Options}" SelectedIndex="0" />
                    <ComboBox ItemsSource="{Binding Options}" SelectedIndex="0" toolkit:Sizing.Size="lg" />
                </StackPanel>
            </c:CodeExample>
        </StackPanel>
    </ScrollViewer>
</UserControl>
