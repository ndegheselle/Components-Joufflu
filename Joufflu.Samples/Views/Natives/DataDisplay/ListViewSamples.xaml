<UserControl
    x:Class="Joufflu.Samples.Views.Natives.DataDisplay.ListViewSamples"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:Joufflu.Samples.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="clr-namespace:Joufflu.Toolkit;assembly=Joufflu"
    xmlns:vm="clr-namespace:Joufflu.Samples.Views.Natives.DataDisplay"
    d:DataContext="{d:DesignInstance Type=vm:ListViewSamplesViewModel}"
    mc:Ignorable="d">
    <ScrollViewer Padding="{StaticResource {x:Static joufflu:Dimensions.SpacingThickness}}" VerticalScrollBarVisibility="Auto">
        <StackPanel toolkit:Spacing.Gap="{StaticResource {x:Static joufflu:Dimensions.SpacingThickness}}">
            <TextBlock Style="{StaticResource H1}" Text="List view" />

            <c:CodeExample
                Title="Grid view columns"
                Code="{Binding Code}"
                Description="A ListView with a GridView shows tabular, sortable-looking columns with draggable headers.">
                <ListView Height="200" ItemsSource="{Binding People}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn
                                Width="160"
                                DisplayMemberBinding="{Binding Name}"
                                Header="Name" />
                            <GridViewColumn
                                Width="140"
                                DisplayMemberBinding="{Binding Role}"
                                Header="Role" />
                            <GridViewColumn
                                Width="80"
                                DisplayMemberBinding="{Binding Age}"
                                Header="Age" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </c:CodeExample>
        </StackPanel>
    </ScrollViewer>
</UserControl>
