<UserControl
    x:Class="Joufflu.Samples.Views.Natives.DataDisplay.DataGridSamples"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:Joufflu.Samples.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="clr-namespace:Joufflu.Toolkit;assembly=Joufflu"
    xmlns:vm="clr-namespace:Joufflu.Samples.Views.Natives.DataDisplay"
    d:DataContext="{d:DesignInstance Type=vm:DataGridSamplesViewModel}"
    mc:Ignorable="d">
    <ScrollViewer Padding="{StaticResource {x:Static joufflu:Dimensions.SpacingThickness}}" VerticalScrollBarVisibility="Auto">
        <StackPanel

            toolkit:Spacing.Gap="{StaticResource {x:Static joufflu:Dimensions.SpacingThickness}}">
            <TextBlock
                Style="{StaticResource H1}"
                Text="Data grid" />

            <c:CodeExample
                Title="Editable grid"
                Code="{Binding Code}"
                Description="A DataGrid with explicit columns. Cells are editable and rows can be selected.">
                <DataGrid
                    Height="220"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    ItemsSource="{Binding People}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="*" Binding="{Binding Name}" Header="Name" />
                        <DataGridTextColumn Width="*" Binding="{Binding Role}" Header="Role" />
                        <DataGridTextColumn Width="80" Binding="{Binding Age}" Header="Age" />
                    </DataGrid.Columns>
                </DataGrid>
            </c:CodeExample>

            <c:CodeExample
                Title="Compact (xs) grid"
                Code="{Binding CompactCode}"
                Description="The inherited Sizing.Size attached property scales the padding of headers and cells, and the font size of cells.">
                <DataGrid
                    Height="220"
                    toolkit:Sizing.Size="xs"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    ItemsSource="{Binding People}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="*" Binding="{Binding Name}" Header="Name" />
                        <DataGridTextColumn Width="*" Binding="{Binding Role}" Header="Role" />
                        <DataGridTextColumn Width="80" Binding="{Binding Age}" Header="Age" />
                    </DataGrid.Columns>
                </DataGrid>
            </c:CodeExample>
        </StackPanel>
    </ScrollViewer>
</UserControl>
