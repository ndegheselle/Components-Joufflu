<UserControl
    x:Class="Joufflu.Samples.Views.Natives.Actions.ButtonSamples"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:Joufflu.Samples.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fonts="clr-namespace:Joufflu.Assets.Fonts;assembly=Joufflu"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="clr-namespace:Joufflu.Toolkit;assembly=Joufflu"
    xmlns:vm="clr-namespace:Joufflu.Samples.Views.Natives.Actions"
    d:DataContext="{d:DesignInstance Type=vm:ButtonSamplesViewModel}"
    mc:Ignorable="d">
    <ScrollViewer Padding="{StaticResource {x:Static joufflu:Dimensions.SpacingThickness}}" VerticalScrollBarVisibility="Auto">
        <StackPanel toolkit:Spacing.Gap="{StaticResource {x:Static joufflu:Dimensions.SpacingThickness}}">
            <TextBlock Style="{StaticResource H1}" Text="Button" />

            <c:CodeExample
                Title="Variants"
                Code="{Binding VariantsCode}"
                Description="Named styles map to the design system's semantic brushes. Apply them through the Style property.">
                <WrapPanel toolkit:Spacing.Gap="8,0">
                    <Button>Default</Button>
                    <Button Style="{StaticResource PrimaryButton}">Primary</Button>
                    <Button Style="{StaticResource SecondaryButton}">Secondary</Button>
                    <Button Style="{StaticResource GhostButton}">Ghost</Button>
                    <Button Style="{StaticResource SuccessButton}">Success</Button>
                    <Button Style="{StaticResource DangerButton}">Danger</Button>
                    <Button Style="{StaticResource InfoButton}">Info</Button>
                    <Button Style="{StaticResource WarningButton}">Warning</Button>
                    <Button IsEnabled="False">Disabled</Button>
                </WrapPanel>
            </c:CodeExample>

            <c:CodeExample
                Title="Soft"
                Code="{Binding SoftCode}"
                Description="A tinted background — the semantic hue at low opacity — with the hue itself as text. Because the tint is derived by opacity, it adapts to light/dark and to custom themes. Secondary is achromatic, so it uses a neutral foreground wash.">
                <WrapPanel toolkit:Spacing.Gap="8,0">
                    <Button Style="{StaticResource SoftPrimaryButton}">Primary</Button>
                    <Button Style="{StaticResource SoftSecondaryButton}">Secondary</Button>
                    <Button Style="{StaticResource SoftSuccessButton}">Success</Button>
                    <Button Style="{StaticResource SoftInfoButton}">Info</Button>
                    <Button Style="{StaticResource SoftWarningButton}">Warning</Button>
                    <Button Style="{StaticResource SoftDangerButton}">Danger</Button>
                </WrapPanel>
            </c:CodeExample>

            <c:CodeExample
                Title="Outline"
                Code="{Binding OutlineCode}"
                Description="A coloured border and text over a transparent fill; hovering fills it with the soft tint. Secondary uses the neutral border and foreground.">
                <WrapPanel toolkit:Spacing.Gap="8,0">
                    <Button Style="{StaticResource OutlinePrimaryButton}">Primary</Button>
                    <Button Style="{StaticResource OutlineSecondaryButton}">Secondary</Button>
                    <Button Style="{StaticResource OutlineSuccessButton}">Success</Button>
                    <Button Style="{StaticResource OutlineInfoButton}">Info</Button>
                    <Button Style="{StaticResource OutlineWarningButton}">Warning</Button>
                    <Button Style="{StaticResource OutlineDangerButton}">Danger</Button>
                </WrapPanel>
            </c:CodeExample>

            <c:CodeExample
                Title="Icon buttons"
                Code="{Binding IconCode}"
                Description="IsSquare makes a button as wide as it is tall — ideal for a single icon.">
                <StackPanel toolkit:Spacing.Gap="8,0" Orientation="Horizontal">
                    <Button toolkit:Sizing.IsSquare="True" Style="{StaticResource PrimaryButton}">
                        <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.Plus}" />
                    </Button>
                    <Button toolkit:Sizing.IsSquare="True">
                        <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.Settings}" />
                    </Button>
                    <Button toolkit:Sizing.IsSquare="True" Style="{StaticResource DangerButton}">
                        <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.Trash}" />
                    </Button>
                </StackPanel>
            </c:CodeExample>

            <c:CodeExample
                Title="Sizes"
                Code="{Binding SizesCode}"
                Description="The inherited Sizing.Size attached property scales height, font size and padding.">
                <StackPanel toolkit:Spacing.Gap="8,0" Orientation="Horizontal">
                    <Button VerticalAlignment="Center" toolkit:Sizing.Size="xs">XS</Button>
                    <Button VerticalAlignment="Center" toolkit:Sizing.Size="sm">SM</Button>
                    <Button VerticalAlignment="Center" toolkit:Sizing.Size="md">MD</Button>
                    <Button VerticalAlignment="Center" toolkit:Sizing.Size="lg">LG</Button>
                </StackPanel>
            </c:CodeExample>
        </StackPanel>
    </ScrollViewer>
</UserControl>
