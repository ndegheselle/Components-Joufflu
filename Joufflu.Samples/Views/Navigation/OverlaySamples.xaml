<UserControl
    x:Class="Joufflu.Samples.Views.Navigation.OverlaySamples"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:Joufflu.Samples.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="clr-namespace:Joufflu.Toolkit;assembly=Joufflu"
    xmlns:vm="clr-namespace:Joufflu.Samples.Views.Navigation"
    d:DataContext="{d:DesignInstance Type=vm:OverlaySamplesViewModel}"
    mc:Ignorable="d">
    <ScrollViewer Padding="{StaticResource {x:Static joufflu:Dimensions.SpacingThickness}}" VerticalScrollBarVisibility="Auto">
        <StackPanel toolkit:Spacing.Gap="{StaticResource {x:Static joufflu:Dimensions.SpacingThickness}}">
            <TextBlock Style="{StaticResource H1}" Text="Overlay" />

            <c:CodeExample
                Title="Modal overlays"
                Code="{Binding Code}"
                Description="Overlays are modal content shown above the page. They have a title bar with a close cross, a content area and an optional action bar. Multiple overlays stack.">
                <WrapPanel toolkit:Spacing.Gap="8,8">
                    <Button Command="{Binding OpenSimpleCommand}" Content="Simple" />
                    <Button
                        Command="{Binding OpenConfirmCommand}"
                        Content="Confirm"
                        Style="{StaticResource PrimaryButton}" />
                    <Button Command="{Binding OpenFormCommand}" Content="Form" />
                    <Button Command="{Binding OpenFullScreenCommand}" Content="Full screen" />
                    <Button Command="{Binding OpenStackedCommand}" Content="Stacked (×2)" />
                </WrapPanel>
            </c:CodeExample>
        </StackPanel>
    </ScrollViewer>
</UserControl>
