<UserControl
    x:Class="Joufflu.Samples.Views.Navigation.PagingSamples"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:Joufflu.Samples.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:local="clr-namespace:Joufflu.Samples.Views.Navigation"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:nav="clr-namespace:Joufflu.Navigation.Controls;assembly=Joufflu.Navigation"
    xmlns:toolkit="clr-namespace:Joufflu.Toolkit;assembly=Joufflu"
    d:DataContext="{d:DesignInstance Type=local:PagingSamplesViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <ScrollViewer Padding="{StaticResource {x:Static joufflu:Dimensions.SpacingThickness}}" VerticalScrollBarVisibility="Auto">
        <StackPanel toolkit:Spacing.Gap="{StaticResource {x:Static joufflu:Dimensions.SpacingThickness}}">
            <TextBlock Style="{StaticResource H1}" Text="Paging" />
            <c:CodeExample
                Title="Paging"
                Code="{Binding Code}"
                Description="Page selector for a set of Total items. It exposes PageNumber and Capacity (items per page), and the range currently displayed. Pages are elided with a separator when there are more than seven of them.">
                <nav:Paging Total="123" />
            </c:CodeExample>

            <c:CodeExample
                Title="Paged data grid"
                Code="{Binding DataGridCode}"
                Description="Paging only tells you which slice to display, it never touches the data itself. Bind Total to the number of items in the whole set, then bind PageNumber and Capacity two way so the view model is notified of every change and can load the matching slice. The control also raises a PagingChange event with the new page number and capacity for non MVVM code.">
                <StackPanel toolkit:Spacing.Gap="{StaticResource {x:Static joufflu:Dimensions.SpacingThickness}}">
                    <DataGrid
                        Height="260"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        IsReadOnly="True"
                        ItemsSource="{Binding PageItems}">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="60"
                                Binding="{Binding Id}"
                                Header="Id" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Name}"
                                Header="Name" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding City}"
                                Header="City" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <nav:Paging
                        Capacity="{Binding Capacity, Mode=TwoWay}"
                        PageNumber="{Binding PageNumber, Mode=TwoWay}"
                        Total="{Binding Total}" />
                </StackPanel>
            </c:CodeExample>

            <c:CodeExample
                Title="Paging without a known total"
                Code="{Binding NoTotalCode}"
                Description="Leave Total at its -1 default when the size of the set is unknown (a cursor based API, a stream). The range label is hidden and the page list grows one page ahead of the current one, so the user can always move forward. Set Total as soon as you know it and the control switches back to a bounded list.">
                <nav:Paging />
            </c:CodeExample>
        </StackPanel>
    </ScrollViewer>
</UserControl>
