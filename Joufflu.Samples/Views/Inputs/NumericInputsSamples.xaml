<UserControl
    x:Class="Joufflu.Samples.Views.Inputs.NumericInputsSamples"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:Joufflu.Samples.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:format="clr-namespace:Joufflu.Inputs.Controls.Format;assembly=Joufflu.Inputs"
    xmlns:inputs="clr-namespace:Joufflu.Inputs.Controls;assembly=Joufflu.Inputs"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="clr-namespace:Joufflu.Toolkit;assembly=Joufflu"
    xmlns:vm="clr-namespace:Joufflu.Samples.Views.Inputs"
    d:DataContext="{d:DesignInstance Type=vm:NumericInputsSamplesViewModel}"
    mc:Ignorable="d">
    <ScrollViewer Padding="{StaticResource {x:Static joufflu:Dimensions.SpacingThickness}}" VerticalScrollBarVisibility="Auto">
        <StackPanel toolkit:Spacing.Gap="{StaticResource {x:Static joufflu:Dimensions.SpacingThickness}}">
            <TextBlock Style="{StaticResource H1}" Text="Numeric &amp; format inputs" />

            <c:CodeExample
                Title="NumericUpDown"
                Code="{Binding NumericCode}"
                Description="Selects a whole number. Built on FormatTextBox with the numeric format, clear and increment/decrement buttons included.">
                <StackPanel toolkit:Spacing.Gap="12,0" Orientation="Horizontal">
                    <inputs:NumericUpDown Width="180" Value="{Binding NumericValue, Mode=TwoWay}" />
                    <TextBlock VerticalAlignment="Center" Text="{Binding NumericValue, StringFormat='Value: {0}'}" />
                </StackPanel>
            </c:CodeExample>

            <c:CodeExample
                Title="DecimalUpDown"
                Code="{Binding DecimalCode}"
                Description="Selects a double / decimal value using the decimal format.">
                <StackPanel toolkit:Spacing.Gap="12,0" Orientation="Horizontal">
                    <inputs:DecimalUpDown Width="180" Value="{Binding DecimalValue, Mode=TwoWay}" />
                    <TextBlock VerticalAlignment="Center" Text="{Binding DecimalValue, StringFormat='Value: {0}'}" />
                </StackPanel>
            </c:CodeExample>

            <c:CodeExample
                Title="TimeSpanPicker"
                Code="{Binding TimeSpanCode}"
                Description="Selects a TimeSpan through a days/hours/minutes/seconds format.">
                <StackPanel toolkit:Spacing.Gap="12,0" Orientation="Horizontal">
                    <inputs:TimeSpanPicker Width="180" Value="{Binding Duration, Mode=TwoWay}" />
                    <TextBlock VerticalAlignment="Center" Text="{Binding Duration, StringFormat='Value: {0}'}" />
                </StackPanel>
            </c:CodeExample>

            <c:CodeExample
                Title="FormatTextBox"
                Code="{Binding FormatCode}"
                Description="The base input: a format string describes groups that are parsed into individual values and navigated with Tab / arrows.">
                <StackPanel toolkit:Spacing.Gap="4">
                    <format:FormatTextBox toolkit:Sizing.Size="xs" Format="{}{max:23}h {max:59}m {max:59}s" GlobalFormat="numeric" />
                    <format:FormatTextBox toolkit:Sizing.Size="sm" Format="{}{max:23}h {max:59}m {max:59}s" GlobalFormat="numeric" />
                    <format:FormatTextBox Format="{}{max:23}h {max:59}m {max:59}s" GlobalFormat="numeric" />
                    <format:FormatTextBox toolkit:Sizing.Size="lg" Format="{}{max:23}h {max:59}m {max:59}s" GlobalFormat="numeric" />
                </StackPanel>
            </c:CodeExample>
        </StackPanel>
    </ScrollViewer>
</UserControl>
