<UserControl
    x:Class="Joufflu.Samples.Views.FileExplorer.ExplorerListSamples"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:Joufflu.Samples.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fileExplorer="clr-namespace:Joufflu.FileExplorer.Controls;assembly=Joufflu.FileExplorer"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:local="clr-namespace:Joufflu.Samples.Views.FileExplorer"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="clr-namespace:Joufflu.Toolkit;assembly=Joufflu"
    d:DataContext="{d:DesignInstance Type=local:ExplorerListSamplesViewModel}"
    mc:Ignorable="d">
    <ScrollViewer Padding="{StaticResource {x:Static joufflu:Dimensions.SpacingThickness}}" VerticalScrollBarVisibility="Auto">
        <StackPanel toolkit:Spacing.Gap="{StaticResource {x:Static joufflu:Dimensions.SpacingThickness}}">
            <TextBlock Style="{StaticResource H1}" Text="List" />

            <c:CodeExample
                Title="ExplorerList"
                Code="{Binding ExplorerListCode}"
                Description="Lists the nodes of the opened folder, directories first then by natural name order, with each file's size. Double click a folder to open it, right click a node for its menu.">
                <fileExplorer:ExplorerList Height="300" Source="{Binding Source}" />
            </c:CodeExample>

            <c:CodeExample
                Title="Extra columns"
                Code="{Binding ExplorerListColumnsCode}"
                Description="ExtraColumns adds columns after the ones of the list. Each cell is bound to the node of its row, so a node type of your own shows the data it carries : here the path every node has, and a cell template reading the parent folder.">
                <fileExplorer:ExplorerList Height="300" Source="{Binding Source}">
                    <fileExplorer:ExplorerList.ExtraColumns>
                        <GridViewColumn
                            Width="260"
                            DisplayMemberBinding="{Binding Path}"
                            Header="Full path" />
                        <GridViewColumn Header="In folder">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        Foreground="{DynamicResource {x:Static joufflu:Brushes.Foreground100Brush}}"
                                        Text="{Binding Parent.Name}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </fileExplorer:ExplorerList.ExtraColumns>
                </fileExplorer:ExplorerList>
            </c:CodeExample>

            <c:CodeExample
                Title="Filtering the nodes"
                Code="{Binding ExplorerListFilterCode}"
                Description="VisibleNodes chooses the kinds of node shown : All by default, or Files / Directories to keep only one. Here the list keeps only the files.">
                <fileExplorer:ExplorerList
                    Height="300"
                    Source="{Binding Source}"
                    VisibleNodes="Files" />
            </c:CodeExample>
        </StackPanel>
    </ScrollViewer>
</UserControl>
