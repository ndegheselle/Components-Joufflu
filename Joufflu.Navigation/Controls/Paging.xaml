<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fonts="clr-namespace:Joufflu.Assets.Fonts;assembly=Joufflu"
    xmlns:local="clr-namespace:Joufflu.Navigation.Controls"
    xmlns:s="clr-namespace:System;assembly=mscorlib"
    xmlns:toolkit="clr-namespace:Joufflu.Toolkit;assembly=Joufflu">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Joufflu;component/Styles/Natives/Actions/Button.named.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Joufflu;component/Styles/Natives/DataDisplay/Typography.named.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="{x:Type local:Paging}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:Paging}">
                    <Grid DataContext="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal">

                            <Button
                                toolkit:Sizing.IsSquare="True"
                                Command="{Binding PreviousCommand}"
                                Style="{StaticResource GhostButton}">
                                <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.ChevronLeft}" />
                            </Button>

                            <ItemsControl ItemsSource="{Binding AvailablePages}">
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AvailablePages.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.Resources>
                                    <DataTemplate DataType="{x:Type local:PagingSelectionSeparator}">
                                        <Button
                                            Margin="2,0,0,0"
                                            toolkit:Sizing.IsSquare="True"
                                            BorderBrush="Transparent"
                                            Content="..."
                                            IsEnabled="False" />
                                    </DataTemplate>
                                    <DataTemplate DataType="{x:Type local:PagingSelectionItem}">
                                        <ToggleButton
                                            Margin="2,0,0,0"
                                            toolkit:Sizing.IsSquare="True"
                                            Command="{Binding GotToCommand, RelativeSource={RelativeSource AncestorType={x:Type local:Paging}}}"
                                            CommandParameter="{Binding Target}"
                                            Content="{Binding Target}"
                                            IsChecked="{Binding IsActive}" />
                                    </DataTemplate>
                                </ItemsControl.Resources>
                            </ItemsControl>

                            <Button
                                Margin="2,0,0,0"
                                toolkit:Sizing.IsSquare="True"
                                Command="{Binding NextCommand}"
                                Style="{StaticResource GhostButton}">
                                <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.ChevronRight}" />
                            </Button>
                        </StackPanel>

                        <StackPanel
                            Grid.Column="1"
                            toolkit:Spacing.Gap="8"
                            Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style BasedOn="{StaticResource Muted}" TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Total}" Value="-1">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0}-{1} of {2}">
                                        <Binding Path="IntervalMin" />
                                        <Binding Path="IntervalMax" />
                                        <Binding Path="Total" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <ComboBox
                                ItemStringFormat="{}{0} / page"
                                ItemsSource="{Binding AvailableCapacities}"
                                SelectedIndex="0"
                                SelectedItem="{Binding Capacity}" />
                        </StackPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
