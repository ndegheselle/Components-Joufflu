<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fonts="clr-namespace:Joufflu.Assets.Fonts;assembly=Joufflu"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:nav="clr-namespace:Joufflu.Navigation.Controls"
    xmlns:toolkit="clr-namespace:Joufflu.Toolkit;assembly=Joufflu">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Joufflu;component/Styles/Dimensions.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Joufflu;component/Styles/Natives/Actions/Button.named.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Joufflu;component/Styles/Natives/DataDisplay/Typography.named.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--  ============================ NavigationItem ============================  -->
    <Style TargetType="{x:Type nav:NavigationItem}">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static joufflu:Brushes.ForegroundBrush}}" />
        <Setter Property="FontSize" Value="{DynamicResource {x:Static joufflu:Dimensions.FontSizeMd}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type nav:NavigationItem}">
                    <Button
                        x:Name="ItemButton"
                        Height="{DynamicResource {x:Static joufflu:Dimensions.HeightMd}}"
                        HorizontalContentAlignment="Stretch"
                        Command="{Binding SelectCommand, RelativeSource={RelativeSource AncestorType={x:Type nav:NavigationMenu}}}"
                        CommandParameter="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                        Style="{DynamicResource GhostButton}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <ContentPresenter
                                x:Name="IconPresenter"
                                Grid.Column="0"
                                Content="{TemplateBinding Icon}" />

                            <ContentPresenter
                                x:Name="ContentPresenter"
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <!--  Recolors custom content, which inherits Foreground from the NavigationItem (not the ItemButton)  -->
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static joufflu:Brushes.PrimaryContentBrush}}" />
                            <Setter TargetName="ItemButton" Property="Background" Value="{DynamicResource {x:Static joufflu:Brushes.PrimaryBrush}}" />
                            <!--  The icon inherits from the ItemButton, so it needs its own override  -->
                            <Setter TargetName="ItemButton" Property="Foreground" Value="{DynamicResource {x:Static joufflu:Brushes.PrimaryContentBrush}}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsCollapsed, RelativeSource={RelativeSource AncestorType={x:Type nav:NavigationMenu}}}" Value="True">
                            <Setter TargetName="ContentPresenter" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ItemButton" Property="Width" Value="{DynamicResource {x:Static joufflu:Dimensions.HeightMd}}" />
                            <Setter TargetName="ItemButton" Property="HorizontalContentAlignment" Value="Center" />
                            <Setter TargetName="ItemButton" Property="Padding" Value="0" />
                            <!--  Collapsed: the label is hidden, so surface it as a tooltip beside the icon  -->
                            <Setter TargetName="ItemButton" Property="toolkit:Tooltip.Content" Value="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="ItemButton" Property="toolkit:Tooltip.Placement" Value="Right" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ============================ NavigationGroup ============================  -->
    <Style TargetType="{x:Type nav:NavigationGroup}">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static joufflu:Brushes.ForegroundBrush}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type nav:NavigationGroup}">
                    <StackPanel>
                        <Button
                            x:Name="HeaderButton"
                            HorizontalContentAlignment="Stretch"
                            Command="{Binding ToggleCommand, RelativeSource={RelativeSource TemplatedParent}}"
                            Style="{DynamicResource GhostButton}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ContentPresenter
                                    x:Name="IconPresenter"
                                    Grid.Column="0"
                                    Content="{TemplateBinding Icon}" />

                                <ContentPresenter
                                    x:Name="ContentPresenter"
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    ContentSource="Header" />

                                <fonts:FontIcon
                                    x:Name="Chevron"
                                    Grid.Column="2"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    Text="{x:Static fonts:LucideFontIcons.ChevronDown}" />
                            </Grid>
                        </Button>

                        <Border
                            x:Name="ChildrenHost"
                            Margin="16,0,0,0"
                            Padding="8,0,0,0"
                            BorderBrush="{DynamicResource {x:Static joufflu:Brushes.BorderBrush}}"
                            BorderThickness="1,0,0,0"
                            Visibility="Collapsed">
                            <ItemsPresenter />
                        </Border>
                    </StackPanel>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ChildrenHost" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Chevron" Property="Text" Value="{x:Static fonts:LucideFontIcons.ChevronUp}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsCollapsed, RelativeSource={RelativeSource AncestorType={x:Type nav:NavigationMenu}}}" Value="True">
                            <Setter TargetName="ContentPresenter" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Chevron" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ChildrenHost" Property="Margin" Value="0" />
                            <Setter TargetName="ChildrenHost" Property="Padding" Value="0" />
                            <Setter TargetName="ChildrenHost" Property="BorderThickness" Value="0" />
                            <Setter TargetName="HeaderButton" Property="Width" Value="{DynamicResource {x:Static joufflu:Dimensions.HeightMd}}" />
                            <Setter TargetName="HeaderButton" Property="HorizontalContentAlignment" Value="Center" />
                            <Setter TargetName="HeaderButton" Property="Padding" Value="0" />
                            <!--  Collapsed: the header is hidden, so surface it as a tooltip beside the icon  -->
                            <Setter TargetName="HeaderButton" Property="toolkit:Tooltip.Content" Value="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="HeaderButton" Property="toolkit:Tooltip.Placement" Value="Right" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ============================ NavigationTitle ============================  -->
    <Style TargetType="{x:Type nav:NavigationTitle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type nav:NavigationTitle}">
                    <Grid Margin="0,12,0,4">
                        <ContentPresenter x:Name="TitleText" TextBlock.Foreground="{DynamicResource {x:Static joufflu:Brushes.Foreground100Brush}}">
                            <ContentPresenter.Resources>
                                <Style BasedOn="{StaticResource Small}" TargetType="{x:Type TextBlock}" />
                            </ContentPresenter.Resources>
                        </ContentPresenter>

                        <Border
                            x:Name="TitleLine"
                            Height="{StaticResource {x:Static joufflu:Dimensions.Thickness}}"
                            VerticalAlignment="Center"
                            Background="{DynamicResource {x:Static joufflu:Brushes.BorderBrush}}"
                            Visibility="Collapsed" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsCollapsed, RelativeSource={RelativeSource AncestorType={x:Type nav:NavigationMenu}}}" Value="True">
                            <Setter TargetName="TitleText" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="TitleLine" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ============================ NavigationMenu ============================  -->
    <Style TargetType="{x:Type nav:NavigationMenu}">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static joufflu:Brushes.ForegroundBrush}}" />
        <Setter Property="Background" Value="{DynamicResource {x:Static joufflu:Brushes.Background100Brush}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static joufflu:Brushes.BorderBrush}}" />
        <!--  Right edge only: the menu just separates itself from the content beside it.  -->
        <Setter Property="toolkit:Derive.BorderThickness" Value="{x:Static joufflu:Dimensions.Thickness}" />
        <Setter Property="toolkit:Derive.BorderThicknessFactor" Value="0,0,1,0" />
        <Setter Property="Width" Value="220" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type nav:NavigationMenu}">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ContentPresenter
                                    x:Name="HeaderPresenter"
                                    Grid.Column="0"
                                    Margin="8"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding Header}" />

                                <Button
                                    x:Name="CollapseButton"
                                    Grid.Column="1"
                                    Margin="8"
                                    HorizontalAlignment="Right"
                                    toolkit:Sizing.IsSquare="True"
                                    Command="{Binding ToggleCollapseCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                    Style="{StaticResource GhostButton}">
                                    <fonts:FontIcon x:Name="CollapseIcon" Text="{x:Static fonts:LucideFontIcons.PanelLeftClose}" />
                                </Button>
                            </Grid>

                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter Margin="8,0,8,8" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsCollapsed" Value="True">
                            <Setter Property="Width" Value="auto" />
                            <Setter TargetName="HeaderPresenter" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="CollapseButton" Property="HorizontalAlignment" Value="Center" />
                            <Setter TargetName="CollapseIcon" Property="Text" Value="{x:Static fonts:LucideFontIcons.PanelLeftOpen}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
